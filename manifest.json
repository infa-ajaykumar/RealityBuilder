{
  "manifest_version": 3,
  "name": "Opsgenie Alert Monitor",
  "version": "1.0",
  "description": "Monitors an Opsgenie alert page and performs actions.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {}
  }
}